---
import { Heart } from '@lucide/astro';
import { site } from '../config/site';
const year = new Date().getFullYear();
---
<footer class="site-footer text-center reveal">
  <div class="footer-ornament" aria-hidden="true"><span></span><Heart size={12} stroke-width={1.25} /><span></span></div>
  <p class="footer-signature">Beleza em cada detalhe.</p>
  <p class="copyright">© {site.name} — {year}</p>
</footer>
